# ============================================================
# Cloud Forix — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to version control.
# ============================================================

# ---- Google API (OAuth2) ----
# Download credentials.json from Google Cloud Console
# (APIs & Services > Credentials > OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_PROJECT_ID=your_google_project_id_here

# ---- Microsoft Azure / Microsoft Graph ----
# Register an app in Azure Active Directory > App Registrations
AZURE_TENANT_ID=your_azure_tenant_id_here
AZURE_CLIENT_ID=your_azure_client_id_here
AZURE_CLIENT_SECRET=your_azure_client_secret_here

# ---- VirusTotal ----
# Obtain from https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# ---- Email Alerts (Gmail SMTP) ----
# Use a Gmail App Password (not your main account password)
# See: https://support.google.com/accounts/answer/185833
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_gmail_app_password_here
RECEIVER_EMAIL=alert_receiver@example.com

# ---- EMS Web Collector (optional) ----
EMS_URL=https://your-ems-portal-url.here/
